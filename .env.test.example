# Copy to .env.test on the server. Never commit the real file.
POSTGRES_DB=quanyi_app
POSTGRES_USER=quanyi_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ORIGIN=https://quanyigeo.com
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3389
APP_BASE_PATH=/ai-task/
APP_API_BASE_URL=/ai-task/api

# Application environments must not create demonstration records.
SEED_DEMO_DATA=false

# Start with explicit Mock until Ollama is installed/reachable on the server.
AI_MODE=mock
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:7b
AI_DAILY_BUDGET_USD=1.0

# Public URL used inside invitation emails.
PUBLIC_APP_URL=https://quanyigeo.com/ai-task/

# Tencent Enterprise Mail (store real values only in the server-side .env.application).
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-with-mail-authorization-code
SMTP_FROM_EMAIL=sender@example.com
SMTP_FROM_NAME=全意 AI 工作中枢
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10

# Enterprise WeChat custom app. CorpID is found under 我的企业 → 企业信息.
WECOM_CORP_ID=ww-replace-with-enterprise-id
WECOM_AGENT_ID=replace-with-agent-id
WECOM_APP_SECRET=replace-with-custom-app-secret
